{
  "name": "hcc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:manager": "turbo build --filter manager",
    "build:spectator": "turbo build --filter spectator",
    "dev": "turbo dev --parallel",
    "dev:manager": "turbo dev --filter manager",
    "dev:spectator": "turbo dev --filter spectator",
    "format": "turbo format",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@oxfmt/binding-win32-x64-msvc": "^0.41.0",
    "@oxlint/binding-win32-x64-msvc": "^1.56.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0",
    "turbo": "^2.5.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm lint --",
      "pnpm format --"
    ],
    "*.{json,yml}": [
      "pnpm format --"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.1"
}
