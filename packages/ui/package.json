    "playwright": "^1.59.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rollup": "^4.52.3",
    "storybook": "^10.3.5",
    "typescript": "^5.9.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.5"
