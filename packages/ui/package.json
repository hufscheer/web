    "@radix-ui/react-slot": "^1.2.3",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "clsx": "^2.1.1",
    "react-aria": "^3.48.0",
    "sonner": "^2.0.7",
    "ts-pattern": "^5.8.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
