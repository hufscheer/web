{
  "name": "@hcc/ui",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    },
    "./styles.css": "./dist/esm/index.css"
  },
  "scripts": {
    "build": "rollup -c rollup.config.cjs",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prebuild": "rm -rf dist"
  },
  "dependencies": {
    "@hcc/icons": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "clsx": "^2.1.1",
    "sonner": "^2.0.7",
    "ts-pattern": "^5.8.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@hcc/rollup-config": "workspace:*",
    "@hcc/typescript-config": "workspace:*",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "rollup": "^4.52.3",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
