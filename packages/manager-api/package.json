{
  "name": "@hcc/manager-api",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.mjs"
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.cjs && tsc -p tsconfig.json",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prebuild": "rm -rf dist"
  },
  "dependencies": {
    "@hcc/api-base": "workspace:*",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@tanstack/react-query": "^5.90.2",
    "ky": "^1.11.0"
  },
  "devDependencies": {
    "@hcc/rollup-config": "workspace:*",
    "@hcc/typescript-config": "workspace:*",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "rollup": "^4.52.3",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
