{
  "name": "@hcc/api-base",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "rollup -c rollup.config.cjs",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome lint --fix",
      "biome format --write"
    ]
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-query-devtools": "^5.87.4",
    "ky": "^1.10.0"
  },
  "devDependencies": {
    "@hcc/rollup-config": "workspace:*",
    "@hcc/typescript-config": "workspace:*",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "rollup": "^4.50.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
