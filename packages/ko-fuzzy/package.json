{
  "name": "@hcc/ko-fuzzy",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.cjs",
    "prebuild": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@hcc/rollup-config": "workspace:*",
    "@hcc/typescript-config": "workspace:*",
    "rollup": "^4.52.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
