{
  "name": "@hcc/toolkit",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "rollup -c rollup.config.cjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "dayjs": "^1.11.18"
  },
  "devDependencies": {
    "@hcc/rollup-config": "workspace:*",
    "@hcc/typescript-config": "workspace:*",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "rollup": "^4.52.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
